# ============================================================
# Projeto Cláudio — variáveis de ambiente (exemplo)
# Copie para .env e preencha os valores. NUNCA comite o .env.
# ============================================================

# === Ambiente ===
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
DOMAIN=localhost

# === Banco de Dados (PostgreSQL) ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=claudio
POSTGRES_USER=claudio
POSTGRES_PASSWORD=troque_esta_senha
# URL usada pela aplicação (host "db" dentro do docker-compose)
DATABASE_URL=postgresql+asyncpg://claudio:troque_esta_senha@db:5432/claudio

# === Redis ===
REDIS_PASSWORD=troque_redis
REDIS_URL=redis://:troque_redis@redis:6379/0

# === Auth / Segurança ===
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=gere_uma_chave_forte_de_256_bits
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480        # 8h
REFRESH_TOKEN_EXPIRE_DAYS=7
SENSITIVE_TOKEN_EXPIRE_MINUTES=30
# Hash bcrypt da senha sensível (financeiro/dashboard dono).
# Gere com: python -c "import bcrypt; print(bcrypt.hashpw(b'senha', bcrypt.gensalt(12)).decode())"
SENSITIVE_PASSWORD_HASH=
# Chave Fernet para criptografar tokens JusBrasil.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# === LLM (Ollama) ===
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_TIMEOUT=120

# === Whisper (transcrição) ===
WHISPER_MODEL=tiny              # tiny para dev; medium em produção
WHISPER_DEVICE=cpu              # cpu | cuda
WHISPER_COMPUTE_TYPE=int8       # int8 (cpu) | float16 (gpu)
WHISPER_LANGUAGE=pt

# === WhatsApp (WA-AKG — gateway não-oficial, Baileys) ===
# A URL base, API key e session_id são configuráveis pela tela de Configurações.
WAAKG_DB_PASSWORD=troque_waakg_db
WAAKG_AUTH_SECRET=troque-este-segredo-waakg
# Webhook que o WA-AKG deve chamar ao receber mensagens:
#   http://backend:8000/api/whatsapp/webhook

# === Celery ===
CELERY_BROKER_URL=redis://:troque_redis@redis:6379/0
CELERY_RESULT_BACKEND=redis://:troque_redis@redis:6379/0

# === Integrações jurídicas ===
DATAJUD_API_KEY=
JUSBRASIL_DEFAULT_TOKEN=

# === Backup ===
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30

# === CORS (origens permitidas, separadas por vírgula) ===
CORS_ORIGINS=http://localhost:5173,http://localhost
